  "limits": {
    "MAX_INPUT_BYTES": 4194304,
    "MAX_DEPTH": 32,
    "MAX_NUMBER_TOKEN_CHARS": 48,
    "MAX_INTEGER_DIGITS": 40,
    "MAX_COEFFICIENT_DIGITS": 40,
    "MAX_EXPONENT_DIGITS": 4
  },
  "limits_basis": {
    "measured": "results/measurement/retained_json.json (33 retained JSON files): at most 246236 bytes, depth 7, number tokens of at most 20 characters, 6 integer digits, 18 coefficient digits, no exponent",
    "MAX_INPUT_BYTES": "4 MiB, 17 times the largest retained file; checked on the bytes before decoding",
    "MAX_DEPTH": "32 nested containers, 4.5 times the deepest retained file (7)",
    "MAX_INTEGER_DIGITS": "40 digits (sign not counted), far below the interpreter's 4300-digit int/str limit",
    "MAX_COEFFICIENT_DIGITS": "40 digits before the exponent, '.' and sign not counted; leading zeros count",
    "MAX_EXPONENT_DIGITS": "4 digits of exponent text, sign not counted, leading zeros counted: admits 1e400, 2e400, 1e-4000, 2e-4000 and 1e9999, rejects 1e10000 and 1e00001",
    "MAX_NUMBER_TOKEN_CHARS": "48 = sign + 40 digits + '.' + 'e' + exponent sign + 4 digits; the first, cheapest check"
  },
  "policy": {
    "P1_parsing": "integer tokens become int and fraction/exponent tokens become decimal.Decimal, both converted from the token text after the limits below are checked; JSON types are 'boolean', 'integer' and 'decimal' and are never equal to each other; duplicate object keys and the literals NaN, Infinity and -Infinity are invalid input; 1e400 is a finite number token, not a non-finite constant",
    "P2_decimal_equality": "two decimals are equal when a == b (exact numeric value) and, if both are zero, a.is_signed() == b.is_signed(); so 1.0 == 1.00 == 1e0, 0.0 != -0.0, -0.0 == -0e0; no compare_total, no spelling equality, no normalize/quantize/unary plus, no float; the integer token -0 parses as int 0 (legacy policy) and equals 0",
    "P3_structure": "unchanged complete recursive comparison: JSON type, object key sets and key order, array length and order, scalars; only the values at environment.python, environment.platform and environment.machine may differ and their keys must exist on both sides; compare() rejects native float, non-finite Decimal and other non-JSON values (UnsupportedValueError) and containers nested deeper than MAX_DEPTH (LimitExceededError)",
    "P4_as_json": "json.dumps(value, ensure_ascii=False, allow_nan=False, default=<reject>) and then the exact parser: str subclasses become str as before; a float is compared by the text it emits (its repr), so precision already lost in the float is not recovered; nan/inf and native Decimal are rejected explicitly (UnsupportedValueError)",
    "P5_diagnostics": "display data only, never compared: a decimal is shown with str() (finite, every digit, a valid JSON number); numbers and containers are never cut; a string longer than 160 characters is cut and labelled with its length and a sha256 prefix; text that cannot be encoded as UTF-8 is shown with \\u escapes; value tags name the JSON type; CLI exit 0 equal, 1 different, 2 invalid/unreadable/unsupported; limits and recursion are reported as invalid input, never as equality and never as a traceback",
    "P6_limits": "LIMITS are enforced as follows: the byte ceiling on the bytes read (at most MAX_INPUT_BYTES + 1 are read) before UTF-8 decoding; the numeric limits in the parse_int/parse_float hooks on the token text before int() or Decimal() runs, the exponent text length before any conversion; tokens must be ASCII JSON number characters; the interpreter's global int/str digit limit is left unchanged",
    "P7_scope": "the hooks run after the json scanner has matched the whole token (that scan is bounded only by the byte ceiling); no new lexical parser; no claim of safety for arbitrary input"
  },
  "environment_exceptions": [
    [
      "environment",
      "python"
    ],
    [
      "environment",
      "platform"
    ],
    [
      "environment",
      "machine"
    ]
  ],
